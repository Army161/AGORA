{
  "_comment": "Paste the 'agora' block into your Claude Desktop mcpServers config.",
  "_comment2": "Set AGORA_WORKSPACE before opening Claude Desktop, or replace the placeholder.",
  "_desktop_config_paths": {
    "macOS":   "~/Library/Application Support/Claude/claude_desktop_config.json",
    "Windows": "%APPDATA%\\Claude\\claude_desktop_config.json",
    "Linux":   "~/.config/Claude/claude_desktop_config.json"
  },
  "mcpServers": {
    "agora": {
      "command": "python3",
      "args": [
        "/ABSOLUTE/PATH/TO/AGORA/server/agora_mcp.py",
        "--workspace",
        "/ABSOLUTE/PATH/TO/.agora/main"
      ],
      "env": {
        "AGORA_WORKSPACE": "/ABSOLUTE/PATH/TO/.agora/main"
      }
    }
  }
}
